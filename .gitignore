# ==========================================
# OpenRatchet - Git Ignore
# ==========================================

# --- Build Directories & Dependencies ---
/build/
/out/
/bin/
cmake-build-*/
/third_party/

# --- Generated Files ---
/generated/*
!/generated/.gitkeep

# --- Logs, Dumps & Media ---
*.log
*_log.txt
ps2_log.txt
*.dmp
*.dump

# Game Dumps & ROMs
*.iso
*.bin
*.cue
*.img
*.mcd
*.ps2

# --- C / C++ & CMake Build Artifacts ---
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake

# Objects, Libraries & Binaries
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.lib
*.a
*.la
*.lo
*.exe
*.elf
*.pdb
*.idb
*.ilk
*.exp

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage

# --- IDEs & Editors ---
# Visual Studio
.vs/
*.vcxproj.user
*.sln.docstates
*.suo
*.user

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (CLion, PyCharm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Xcode
*.mode1v3
*.pbxuser
*.xcuserdata

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
